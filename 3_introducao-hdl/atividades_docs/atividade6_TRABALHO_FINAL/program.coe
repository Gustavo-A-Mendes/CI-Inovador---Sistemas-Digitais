; Inicializacao da Memoria do Processador Neander
; Mapa do Programa:
; 0x00-0x01: 20, 81 (LDA 129)
; 0x02-0x03: 30, 82 (ADD 130)
; 0x04-0x05: 10, 80 (STA 128)
; 0x06:      F0     (HLT)

; 0x07-0x7F: Preenchimento com 00 (121 bytes)

; 0x80:      00 (Resultado esperado = 05)
; 0x81:      02 (Dado 1)
; 0x82:      03 (Dado 2)

memory_initialization_radix=16;
