; Inicializacao da Memoria do Processador Neander
memory_initialization_radix=16;
memory_initialization_vector=
; --- AREA DE PROGRAMA (Enderecos 0x00 a 0x06) ---
20, 81, ; 0x00-0x01: LDA @81
30, 82, ; 0x02-0x03: ADD @82
10, 80, ; 0x04-0x05: STA @80
F0,     ; 0x06:      HALT

; --- PREENCHIMENTO ATE @80 (Enderecos 0x07 a 0x7F -> 121 bytes) ---
                            00, 00, 00, 00, 00, 00, 00, 00, 00,
00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00,
00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00,
00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00,
00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00,
00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00,
00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00,
00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00, 00,

; --- AREA DE DADOS (Enderecos 0x80 a 0x82) ---
00,     ; 0x80: Resultado
02,     ; 0x81: Dado 1
03;     ; 0x82: Dado 2
