database -open waves -into waves.shm -default
probe -create -shm regbank_tb.clk regbank_tb.rst regbank_tb.d regbank_tb.en regbank_tb.q regbank_tb.dut.g[0].rg.d regbank_tb.dut.g[0].rg.en regbank_tb.dut.g[0].rg.q regbank_tb.dut.g[1].rg.d regbank_tb.dut.g[1].rg.en regbank_tb.dut.g[1].rg.q regbank_tb.dut.g[2].rg.d regbank_tb.dut.g[2].rg.en regbank_tb.dut.g[2].rg.q regbank_tb.dut.g[3].rg.d regbank_tb.dut.g[3].rg.en regbank_tb.dut.g[3].rg.q
